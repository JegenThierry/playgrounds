# Copy to .env (gitignored) and fill in real values.
#
# Required by the `date-api` service (compose will refuse to start without them).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
TO_EMAIL=you@example.com

# Optional — defaults to "Date Request <onboarding@resend.dev>" (Resend sandbox sender).
# FROM_EMAIL=Your Name <noreply@your-domain.com>

# Optional — override published ports if any default collides with something local.
# CHRISTMAS_PORT=1230
# BIRTHDAY_PORT=1231
# EASTER_PORT=1232
# VALENTINES_DAY_PORT=1233
# FLOWER_PORT=1234
# STRESS_SHREDDER_PORT=1235
# FUCK_PORT=1236
# DATE_UI_PORT=1237
# SUNFLOWER_PORT=1238
# PRETTIEST_PORT=1239
